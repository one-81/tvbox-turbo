<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Quando o controle remoto da TV foca no botão -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_focus" />
            <stroke android:width="3dp" android:color="@color/neon_cyan" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Quando o botão é pressionado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_teal" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Estado padrão de repouso -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <stroke android:width="1dp" android:color="@color/border_normal" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
