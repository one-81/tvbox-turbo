<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f111a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- CABEÇALHO COM TÍTULO E BOTÃO DE FERRAMENTAS (🛠️) -->
        <RelativeLayout
            android:layout_width="match_parent"
            
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📺 ATIVADOR TVBOX"
                    android:textColor="#ffffff"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDeviceInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Carregando dados do aparelho..."
                    android:textColor="#8888aa"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- BOTÃO DO MARTELO E CHAVE DE FENDA (🛠️ MENU SUPORTE) -->
            <TextView
                android:id="@+id/btnAdminSettings"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_tv_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="🛠️"
                android:textSize="24sp"
                android:contentDescription="Menu Suporte e Permissões" />
        </RelativeLayout>

        <!-- CAIXA DE ENTRADA DO CÓDIGO -->
        <EditText
            android:id="@+id/etCode"
            android:layout_width="match_parent"
            
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/input_bg"
            android:gravity="center"
            android:hint="DIGITE SEU CÓDIGO DE ATIVAÇÃO"
            android:inputType="textCapCharacters"
            android:padding="12dp"
            android:textColor="#ffffff"
            android:textColorHint="#666688"
            android:textSize="20sp"
            android:textStyle="bold"
            android:focusable="true"
            android:nextFocusDown="@id/btnValidate" />

        <!-- BOTÃO DE VALIDAR -->
        <Button
            android:id="@+id/btnValidate"
            android:layout_width="match_parent"
            
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_tv_selector"
            android:text="1. VERIFICAR CÓDIGO"
            android:textColor="#ffffff"
            android:textSize="17sp"
            android:textStyle="bold"
            android:focusable="true"
            android:nextFocusDown="@id/btnActivate" />

        <!-- BOTÃO DE ATIVAR -->
        <Button
            android:id="@+id/btnActivate"
            android:layout_width="match_parent"
            
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/btn_tv_selector"
            android:text="2. ATIVAR APARELHO"
            android:textColor="#ffffff"
            android:textSize="17sp"
            android:textStyle="bold"
            android:enabled="false"
            android:focusable="true"
            android:nextFocusDown="@id/btnDownloadInstall" />

        <!-- BARRA DE PROGRESSO -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- STATUS / MENSAGEM -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:padding="12dp"
            android:text="Digite o código acima e clique em Verificar."
            android:textColor="#aaaaee"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#252538" />

        <!-- BOTÃO DE BAIXAR / INSTALAR APK -->
        <Button
            android:id="@+id/btnDownloadInstall"
            android:layout_width="match_parent"
            
            android:layout_height="55dp"
            android:background="@drawable/btn_tv_selector"
            android:text="⬇️ BAIXAR / INSTALAR APLICATIVO TV"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:textStyle="bold"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>

